# ----------------------------------------------------------------------------
# Backend (por-elas-api) — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env com valores reais.
# ----------------------------------------------------------------------------

# Chave secreta do Django (gere uma aleatória para produção)
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria

# true em dev, false em produção
DJANGO_DEBUG=true

# Hosts permitidos (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres do Supabase via pooler em modo transação (porta 6543).
# Em dev, deixe vazio para usar SQLite local.
# Exemplo: postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Origens liberadas no CORS (frontend). Separe por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Origens confiáveis para CSRF em produção (Admin). Separe por vírgula.
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Segredo compartilhado com a Vercel Cron (usado em etapas futuras)
CRON_SECRET=
