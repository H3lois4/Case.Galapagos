# ----------------------------------------------------------------------------
# Frontend (por-elas-web) — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA commite valores reais.
# ----------------------------------------------------------------------------

# URL base da API Django (por-elas-api)
# Em dev: http://localhost:8000
# Em produção: https://por-elas-api.vercel.app (ou o domínio do projeto)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (cliente no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (publishable/anon), começa com sb_publishable_ ou eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
